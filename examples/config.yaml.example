# yaml-language-server: $schema=https://raw.githubusercontent.com/not-hanjo-mei/ezyapper/main/examples/config.schema.json
# EZyapper config example
# ------------------------------------------------
# Copy this file to config.yaml and fill in your values.
# ALL fields shown here are required unless marked "optional override".
# Missing any required field = bot refuses to start.
#
# Quick start:
# 1) Fill core.discord + core.ai first
# 2) Choose memory mode:
#    - OFF: memory_pipeline.memory.retrieval.top_k=0 and consolidation.enabled=false
#    - ON: set embedding + qdrant + retrieval/consolidation
# 3) Enable optional modules in operations.* as needed

core:
  # ── Discord Bot Settings ──────────────────────────────
  discord:
    # Discord bot token from Developer Portal:
    # https://discord.com/developers/applications
    token: "YOUR_DISCORD_BOT_TOKEN"

    # Bot display name used in prompts and logs.
    bot_name: "EZyapper"

    # Bot user ID. Used to identify self-messages.
    # NOTE: own_bot_id is unconditionally required in JSON Schema (cross-subtree
    # conditional validation is not expressible in JSON Schema draft 2020-12).
    # Go only requires it when memory consolidation is enabled.
    # Required when memory retrieval (memory_pipeline.memory.retrieval.top_k > 0)
    # or memory consolidation (memory_pipeline.memory.consolidation.enabled) is active.
    own_bot_id: "YOUR_BOT_USER_ID"

    # Random reply probability when bot is NOT mentioned (0.0-1.0).
    reply_percentage: 0.15

    # Minimum seconds between replies for the same user+channel.
    cooldown_seconds: 5

    # Hard cap: max responses per minute across all channels.
    max_responses_per_minute: 10

    # How to treat messages from OTHER bots (not this bot itself).
    # - "ignore":       skip entirely - no response, no memory, no search enrichment
    # - "context_only": include in memory pipeline (retrieval + consolidation) but do NOT reply
    # - "full":         treat other bots like human users - respond AND include in memory
    other_bot_policy: "ignore"

    # ── Rate limit window settings ──
    rate_limit:
      # Window size for per-user rate limiting (seconds).
      reset_period_seconds: 60

    # ── Behavior tuning ──
    # Timeout for consolidation-triggered response generation (seconds).
    consolidation_timeout_sec: 300

    # Interval between typing indicator updates (seconds).
    typing_indicator_interval_sec: 5

    # Delay before sending a response flagged as "long" (milliseconds).
    long_response_delay_ms: 500

    # TTL for cached Discord image data (minutes).
    image_cache_ttl_min: 60

    # Max number of images kept in the in-memory cache.
    image_cache_max_entries: 100

    # Optional /clear-context slash command: makes the bot forget the
    # conversation context of the channel it is run in (only that channel;
    # Discord history, stored data and long-term memory are untouched).
    # Replies are ephemeral. Context is re-fetched from Discord, so this
    # hides older messages until the bot restarts.
    clear_command:
      enabled: false
      allowed_user_ids: []   # Discord user IDs allowed to run it

  # ── AI / LLM Settings ─────────────────────────────────
  ai:
    # OpenAI-compatible API endpoint.
    # Examples:
    #   https://api.openai.com/v1
    #   http://127.0.0.1:3000/v1
    api_base_url: "https://api.openai.com/v1"

    api_key: "YOUR_API_KEY"

    # Main text model.
    model: "gpt-4o-mini"

    # ── Modalities (optional) ──
    # Text is always on: the model above reasons and writes every reply.
    # Image, audio and video are optional, each with its own switch and model.
    # Endpoint fields left empty (api_base_url, api_key, timeout, max_tokens,
    # temperature, retry_count, extra_params) fall back to the core.ai values.
    # "describe"/"asr" modes turn media into text lines on the message in the
    # user prompt ("[Image 1: ...]", "[Audio 1 transcript (...): ...]",
    # "[Video 1 (...): ...]"), cached by attachment ID. "direct" mode sends
    # the media itself in the reply request (the base model, or the
    # modality's model when set, must accept it).
    # The old core.ai.vision block still loads (text_only=off,
    # hybrid=describe, multimodal=direct) but is deprecated.
    modalities:
      image:
        enabled: false
        # describe: a vision model writes a description for the base model.
        # direct:   images are sent in the reply request.
        mode: "describe"
        model: "gpt-4o"            # required for describe
        # prompt: "Describe this image in 1-2 sentences. Be compact but informative. Transcribe any visible text."
        max_items: 4               # images per message
        transport: "base64"        # base64 (inline data URI) or url (provider fetches the CDN URL)
        ## api_base_url: ""
        ## api_key: ""
        ## max_tokens: 1024
        ## timeout: 30

      audio:
        enabled: false
        # asr:    transcribe speech with an OpenAI-compatible
        #         /audio/transcriptions endpoint (e.g. Whisper).
        # direct: send the audio (audio_url data URI) to an audio-capable
        #         model in the reply request.
        mode: "asr"
        model: "whisper-1"         # required for asr
        ## api_base_url: "https://api.openai.com/v1"
        ## api_key: ""
        ## language: "en"          # optional ISO-639-1 hint (asr)
        ## prompt: ""              # optional vocabulary hint (asr)
        max_items: 2
        max_bytes: 26214400        # 25 MiB
        max_duration_sec: 600      # checked when Discord reports a duration (voice messages)
        # Optional ffmpeg conversion before sending: "mp3" or "wav" (empty =
        # send as is). Only needed for an ASR endpoint that rejects ogg/opus
        # voice messages, or for part_type input_audio. Requires ffmpeg.
        ## transcode: ""
        # Direct-mode content part: audio_url (data URI, default) or
        # input_audio (OpenAI format; mp3/wav only, so it needs transcode).
        ## part_type: "audio_url"

      video:
        enabled: false
        mode: "describe"           # the only video mode
        model: "gpt-4o"            # required; must accept video_url parts
        # Reasoning models need room: with too few tokens they return no content.
        ## max_tokens: 12000
        ## prompt: "Describe this video in 2-4 sentences: ..."
        max_items: 1
        max_bytes: 52428800        # 50 MiB
        max_duration_sec: 120
        transport: "base64"
        # Re-encode with ffmpeg before sending: trim to max_duration_sec
        # (instead of skipping longer videos) and scale down to max_height.
        # Requires ffmpeg and transport base64.
        ## transcode: false
        ## max_height: 480

      # ffmpeg is optional. If an enabled option needs it (audio.transcode,
      # video.transcode) and it is missing, the bot refuses to start.
      ## ffmpeg_path: "ffmpeg"

      sticker:
        enabled: false
        # text:   "[Sticker: name — description (tags: ...)]" from Discord, no model call.
        # vision: a vision model describes the sticker image once per sticker
        #         ID (custom guild stickers included). Lottie stickers cannot
        #         be rendered and fall back to text.
        mode: "text"
        # Vision model fields fall back to modalities.image, then core.ai.
        ## model: "gpt-4o"
        ## prompt: "Describe this Discord sticker in one short sentence: ..."
        max_items: 3
        cache_ttl_min: 1440        # sticker details/descriptions cached by sticker ID
        cache_max_entries: 1000

    # ── Response tuning ──
    # Token limit for main chat completion responses.
    max_tokens: 4096

    # 0.0-2.0. Higher = more creative, lower = more deterministic.
    temperature: 0.8

    # Retries for transient API/network errors.
    retry_count: 3

    # timeout controls per-request LLM API call timeout (~30s);
    # global pipeline timeout is auto-calculated from this value.
    timeout: 30

    # Max tool-calling iterations in a single conversation turn.
    # Guards against infinite tool-call loops.
    max_tool_iterations: 5

    # Max bytes for an image fetched from Discord CDN.
    max_image_bytes: 10485760

    # If true, rejects image responses that lack a Content-Type header.
    require_image_content_type: false

    # System prompt. It is sent byte-for-byte unchanged on every request so
    # provider-side prompt caching works: write names literally (there are
    # no {BotName}-style placeholders). Server, channel, participants (with
    # their IDs), history and the current message are sent in the user
    # message instead. See docs/PROMPT_OPTIMIZATION.md for the layout.
    system_prompt: |
      You are Yapper, a helpful Discord bot.

      The user message contains <server_info>, <channel_info>, <context>,
      <participants>, <user_profile>, <key_facts> and <currentMessage>.
      Reply to <currentMessage>. Messages show mentions as <@Name>; to ping
      someone, write <@Name> with a name from <participants>.

      When using tools, ALWAYS use the numeric IDs from <server_info>,
      <channel_info> and <participants>, never names.

      Guidelines:
      - Be natural and conversational
      - Keep responses concise (under 200 words typically)
      - You have access to Discord tools. Use them when appropriate.

    # ── Optional: extra parameters forwarded to the API ──
    ## extra_params: {}

  # ── Decision Classifier ───────────────────────────────
  # When enabled, a model decides whether the bot should respond to messages
  # that neither mention it nor reply to it.
  # Disable if you want simple mention/percentage-based replies.
  decision:
    enabled: false

    # Which decision backend to use:
    #   llm        - an OpenAI-compatible chat model returns a JSON verdict
    #                (default when this key is absent)
    #   system_one - a System One decision model (TypeSafe Jev) returns
    #                P(yes); the bot replies when it reaches the threshold
    ## provider: llm

    # provider: llm - fields below are required ONLY when enabled: true.
    ## model: "gpt-4o-mini"
    ## api_base_url: "https://api.openai.com/v1"
    ## api_key: "YOUR_DECISION_API_KEY"
    ## max_tokens: 64
    ## temperature: 0.1
    ## retry_count: 3
    ## timeout: 10
    ## system_prompt: |
    ##   You are a decision classifier for a Discord bot. Decide if the bot should respond.
    ##   Respond ONLY with valid JSON: {"should_respond": true/false, "reason": "...", "confidence": 0.0-1.0}
    ## extra_params: {}

    # provider: system_one - this block is required ONLY when enabled: true
    # and provider: system_one. The state sent to the model is JSON built from
    # the recent channel messages and the current message (text only).
    # instructions/criteria are sent verbatim: no {BotName} substitution,
    # write the bot's name literally.
    ## system_one:
    ##   api_base_url: "https://api.typesafe.ai/v1"
    ##   api_key: "YOUR_TYPESAFE_API_KEY"
    ##   model: "jev-latest"
    ##   timeout: 10          # per-request seconds
    ##   retry_count: 2       # retries on 429/529/5xx/network errors
    ##   threshold: 0.7       # reply when P(yes) >= threshold, (0, 1]
    ##   instructions: "Should the Discord bot Ezy send a reply to current_message?"
    ##   # Optional, set both or neither:
    ##   criteria_true: "current_message talks to Ezy, asks Ezy or the channel something Ezy can answer, or continues a conversation with Ezy"
    ##   criteria_false: "current_message is aimed at other people, is a reaction or small talk between other users, or needs no reply"
    ##   max_state_bytes: 48000  # JSON state budget; oldest context messages are dropped first

memory_pipeline:
  # ── Embedding Model ───────────────────────────────────
  embedding:
    # Optional override: separate embedding endpoint.
    # Leave empty to inherit from core.ai.api_base_url / core.ai.api_key.
    ## api_base_url: "https://api.openai.com/v1"
    ## api_key: "YOUR_API_KEY"

    # Embedding model for vector search and consolidation.
    # Required when memory retrieval or consolidation is enabled.
    model: "text-embedding-3-small"

    # Retries for embedding API calls.
    retry_count: 1

    # Per-request embedding timeout (seconds).
    timeout: 10

    # ── Optional: extra parameters ──
    ## extra_params: {}

  # ── Memory Settings ───────────────────────────────────
  memory:
    # Trigger consolidation every N bot-handled messages.
    consolidation_interval: 50

    # Number of recent messages to pull as short-term context.
    short_term_limit: 20
    # Anchored context window (prompt-cache friendly). When > 0 the history
    # grows from short_term_limit up to short_term_limit + this many messages
    # and then drops the oldest block at once, instead of sliding by one
    # message per request. 0 = plain sliding window.
    context_flush_window: 20

    # Pagination limit for fetching older messages.
    max_paginated_limit: 100

    # ── Long-Term Memory ──
    long_term_memory:
      # When enabled, memories are consolidated into long-term storage
      # for cross-session recall and user profiling.
      enabled: true

    # Max number of mentioned users tracked per memory entry.
    # Higher values capture more conversational context but increase token usage.
    max_mentioned_users_per_memory: 3

    # Strength multiplier for memory importance scoring (must be > 0 and <= 100).
    # Presets:
    #   0.0001 - extreme: only the most critical facts survive
    #   0.1    - goldfish: weak memories, quick forgetting
    #   1.0    - human: balanced retention and decay
    #   > 1.0  - elephant: memories linger longer
    memory_strength_multiplier: 1.0

    # ── Semantic Retrieval ──
    retrieval:
      # Number of memories returned per retrieval query.
      # Set to 0 to disable long-term memory retrieval.
      top_k: 5

      # Similarity score threshold (0.0-1.0).
      # Memories below this score are filtered out.
      min_score: 0.75

      # Whether to include channel-scoped memories in retrieval results.
      include_channel_memories: true

      # Max memories to retrieve that mention the sender.
      # 0 = disabled, uses top_k instead.
      max_mentioned_memories: 3

      # Max memories to retrieve that are scoped to the current channel.
      # 0 = disabled, uses top_k instead.
      max_channel_memories: 5

    # ── Memory Consolidation ──
    consolidation:
      # Enable writing new long-term memories.
      enabled: false

      # All fields below are required ONLY when enabled: true.
      ## model: "gpt-4o-mini"                         # optional, inherits from core.ai if empty
      ## api_base_url: "https://api.openai.com/v1"    # optional, inherits from core.ai if empty
      ## api_key: "YOUR_API_KEY"                      # optional, inherits from core.ai if empty
      ## max_tokens: 4096
      ## temperature: 0.8
      ## retry_count: 5
      ## timeout: 30

      # ── Optional: separate image-description model for consolidation ──
      # Used only when core.ai.modalities.image is enabled; fields left
      # empty inherit from core.ai.modalities.image (then core.ai).
      ## vision:
      ##   model: "gpt-4o"
      ##   description_prompt: ""
      ##   api_base_url: ""    # optional, inherits from core.ai if empty
      ##   api_key: ""         # optional, inherits from core.ai if empty
      ##   max_tokens: 1024
      ##   temperature: 0.8
      ##   retry_count: 5
      ##   timeout: 30

      # How many existing memories to search for deduplication/similarity.
      memory_search_limit: 20

      # ── Optional: extra parameters ──
      ## extra_params: {}

      # Consolidation system prompt. Required when enabled.
      #
      # Message format: "Username"{UserID=xxx,Time=...,BOT=SELF|OTHERS}: "content"
      #   BOT=SELF   = this bot's own messages - always conversational context only, never extract
      #   BOT=OTHERS = other bots' messages - extraction behavior controlled by prompt below
      #   No BOT marker = human user
      #
      # ── Template for other_bot_policy: "ignore" ──
      # system_prompt: |
      #   You are a memory extraction assistant. Analyze the conversation and extract memorable information about USERS.
      #   ...
      #   - BOT=SELF and BOT=OTHERS: COMPLETELY IGNORE, do not extract
      #   - No BOT marker (human): extract normally
      #   ...
      #
      # ── Template for other_bot_policy: "context_only" ──
      # system_prompt: |
      #   You are a memory extraction assistant. Analyze the conversation and extract memorable information about USERS.
      #   ...
      #   - BOT=SELF: COMPLETELY IGNORE, do not extract
      #   - BOT=OTHERS: extract MINIMALLY - only if notable/unusual and relevant to human users
      #   - No BOT marker (human): extract normally
      #   EXTRACTION RULES - BOT=OTHERS (MINIMAL):
      #   1. Only extract if the bot shares significant information ABOUT human users
      #   2. Do NOT extract bot capabilities, settings, or general bot-to-bot chatter
      #   3. Skip routine bot responses, command confirmations, and standard output
      #   ...
      #
      # ── Template for other_bot_policy: "full" ──
      # system_prompt: |
      #   You are a memory extraction assistant. Analyze the conversation and extract memorable information about USERS.
      #   ...
      #   - BOT=SELF: COMPLETELY IGNORE, do not extract
      #   - BOT=OTHERS: extract normally, same as human users
      #   - No BOT marker (human): extract normally
      #   ...
      #
      # All templates use this output format:
      #   [{"user_id": "...", "memories": [{"content": "...", "type": "fact|episode|interest",
      #   "confidence": 0.0-1.0, "keywords": [], "importance_score": 0.0-1.0,
      #   "profile_updates": {"traits": [], "facts": {}, "preferences": {}, "interests": []}}]}]
      ## system_prompt: |
      ##   Extract memorable information about USERS from this conversation.
      ##   For type=fact, content MUST be "key: value" format with a colon (e.g., "name: Alice", "personality: witty", "favorite_color: blue").
      ##   BAD (no colon, breaks dedup): "My favorite color is blue", "Alice is a software engineer"
      ##   Return JSON array: [{"user_id": "...", "memories": [{"content": "...", "type": "fact|episode|interest", "confidence": 0.0-1.0, "keywords": [], "importance_score": 0.0-1.0, "profile_updates": {"traits": [], "facts": {}, "preferences": {}, "interests": []}}]}]
      ##   - importance_score: 1.0=critical identity info, 0.5=moderate facts, 0.1=trivial
      ##   - profile_updates: populate if memory reveals profile info, leave empty {} otherwise
      ##   - profile_updates.facts is JSON object like {"favorite_color": "blue"} NOT {"favorite_color: blue"}
      ##   - profile_updates.traits is JSON array of strings: ["helpful", "curious"] NOT "helpful, curious"
      ##   - profile_updates.interests is JSON array of strings: ["Go programming", "cats"] NOT "Go programming, cats"
      ##   - profile_updates.preferences is JSON object: {"language": "Go"} NOT "language: Go"

    # ── Maintenance ──
    # Cron-based memory lifecycle management
    maintenance_interval_sec: 3600
    merge_cron_hour_utc: 3
    summarize_cron_day: 0
    merge_cosine_threshold: 0.85
    prune_decay_threshold: 0.1
    prune_age_days: 90
    relationship_prune_age_days: 90
    max_maintenance_llm_calls_per_day: 10

    # ── Entropy Gate ──
    entropy_min_unique_word_ratio: 0.2

    # ── Decay Rates (lower = decays slower) ──
    decay_rates:
      fact: 0.01
      episode: 0.05
      interest: 0.02
      summary: 0.005

    # ── Scoring Weights ──
    scoring:
      importance_weight: 0.4
      recency_weight: 0.3
      access_weight: 0.2
      confidence_weight: 0.1

    # ── RRF + Context ──
    rrf_k: 60
    context_max_memories: 10

  # ── Qdrant Vector Database ────────────────────────────
  qdrant:
    # Qdrant host. Use "localhost" for local, container name for Docker.
    host: "localhost"

    # Qdrant gRPC port (default: 6334).
    port: 6334

    # Optional API key for cloud/secured Qdrant instances.
    ## api_key: "YOUR_QDRANT_API_KEY"

    # Vector dimensions. Must match your embedding model. Changing the model
    # is safe: memories are re-embedded into a new per-model collection.
    # text-embedding-3-small / text-embedding-ada-002 -> 1536
    # text-embedding-3-large                         -> 3072
    vector_size: 1536

    # ── Retry settings for Qdrant operations ──
    # Base delay for exponential backoff (milliseconds).
    retry_base_delay_ms: 1000

    # Max delay for exponential backoff (milliseconds).
    retry_max_delay_ms: 30000

    # Max retry attempts for Qdrant operations.
    max_retries: 3

access_control:
  # ── Blacklist ─────────────────────────────────────────
  # Block specific users, channels, or guilds.
  # Cannot be combined with whitelist for the same category.
  blacklist:
    users: []
    guilds: []
    channels: []

  # ── Whitelist ─────────────────────────────────────────
  # When set, bot ONLY responds in listed users/channels/guilds.
  # Cannot be combined with blacklist for the same category.
  whitelist:
    users: []
    guilds: []
    channels: []

  # ── Message filters (optional) ────────────────────────
  # Regex rules applied to incoming messages, in order; the first matching
  # rule wins, otherwise default_action applies. An ignored message is not
  # answered and is hidden from history, the decision model and memory
  # consolidation. The bot's own messages are never filtered.
  # Patterns are Go regexes searched in the value: anchor IDs with ^...$.
  # kinds: text, embed, image, sticker, audio, voice, video, file, reply, bot, webhook
  #   kinds     = matches if the message has ANY listed kind
  #   kinds_all = matches if the message has ALL listed kinds
  message_filters:
    default_action: allow   # allow | ignore (ignore = whitelist mode)
    rules: []
    # rules:
    #   - name: "status bot embeds in #general"
    #     action: ignore
    #     channel: "^123456789012345678$"
    #     user: "^234567890123456789$"
    #     kinds: [embed]
    #   - name: "prefix commands for other bots"
    #     action: ignore
    #     content: "^[!/]"

operations:
  # ── Web Dashboard ─────────────────────────────────────
  web:
    enabled: false

    # All fields below are required ONLY when enabled: true.
    ## port: 8080
    ## username: "admin"
    ## password: "CHANGE_ME"
    ## memories_page_limit: 50
    ## session_ttl_min: 30
    ## session_cleanup_interval_min: 5
    ## stats_query_timeout_sec: 5
    ## log_default_lines: 100
    ## log_max_lines: 1000
    ## log_max_read_bytes: 1048576

  # ── Logging ───────────────────────────────────────────
  logging:
    # Log level: debug, info, warn, error.
    level: "info"

    # Log file path.
    file: "logs/ezyapper.log"

    # Max log file size before rotation (megabytes).
    max_size: 100

    # Number of rotated backup files to keep.
    max_backups: 3

    # Retention for rotated logs (days).
    max_age: 30

  # ── Plugin System ─────────────────────────────────────
  plugins:
    enabled: false

    # All fields below are required ONLY when enabled: true.
    ## plugins_dir: "plugins"
    ## default_tool_timeout_ms: 30000
    ## startup_timeout_sec: 90
    ## rpc_timeout_sec: 5
    ## before_send_timeout_sec: 180
    ## command_timeout_sec: 45
    ## shutdown_timeout_sec: 5
    ## disable_timeout_sec: 2
    ## max_restarts: 3
    ## restart_cooldown_sec: 300

  # ── MCP Client ────────────────────────────────────────
  mcp:
    enabled: false

    # All fields below are required ONLY when enabled: true.
    # Servers can use "stdio" (subprocess), "sse" (Server-Sent Events),
    # or "http" (Streamable HTTP, MCP 2025-03-26 spec) transport.
    servers: []
    # Example server list:
    # servers:
    #   - name: datetime
    #     type: stdio
    #     command: npx
    #     args: ["-y", "@pinkpixel/datetime-mcp"]
    #     env:
    #       "TZ": "UTC"
    #   - name: remote-sse
    #     type: sse
    #     url: "http://localhost:8080/sse"
    #   - name: remote-http
    #     type: http
    #     url: "http://localhost:8080/mcp"
    #     headers:
    #       Authorization: "Bearer $ANYSEARCH_API_KEY"

  # ── Operational Settings ──────────────────────────────
  runtime:
    # Graceful shutdown grace period (seconds).
    shutdown_timeout_sec: 300

    # Interval for periodic cleanup tasks (minutes).
    cleanup_interval_min: 5

    # Config hot reload: watch this file and apply changes on save without a
    # restart. Invalid edits are rejected (errors logged) and the running
    # config is kept. Fields that need a new connection (Discord token,
    # Qdrant address, embedding endpoint, web port, MCP servers, plugins dir)
    # are reconnected automatically. See docs/CONFIGURATION.md "Hot reload".
    hot_reload:
      enabled: true
      # Quiet period after the last file event before reloading (50-60000 ms).
      debounce_ms: 500
