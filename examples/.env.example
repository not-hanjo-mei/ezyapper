# EZyapper Environment Variables
# ================================
# Copy this file to .env and fill in your values.
#
# All variables use the EZYAPPER_ prefix (handled by Viper) and mirror
# the YAML config path with dots replaced by underscores.
#
# Example:
#   YAML:  core.discord.token     -> EZYAPPER_CORE_DISCORD_TOKEN
#   YAML:  memory_pipeline.qdrant.host -> EZYAPPER_MEMORY_PIPELINE_QDRANT_HOST
#
# NOTE: This bot has NO DEFAULT VALUES. You MUST configure all required
# fields in config.yaml or via environment variables below, or the bot
# will exit on startup.

# ===========================================
# REQUIRED - Bot will not start without these
# ===========================================

# Discord Bot Token
# Get it from: https://discord.com/developers/applications
EZYAPPER_CORE_DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# AI/LLM API Key
EZYAPPER_CORE_AI_API_KEY=YOUR_API_KEY_HERE

# ===========================================
# AI/LLM Configuration (Optional overrides)
# Falls back to config.yaml values if not set
# ===========================================

# Main chat endpoint
EZYAPPER_CORE_AI_API_BASE_URL=https://api.openai.com/v1
# EZYAPPER_CORE_AI_MODEL=gpt-4o-mini
# EZYAPPER_CORE_AI_MAX_TOKENS=1024
# EZYAPPER_CORE_AI_TEMPERATURE=0.8
# EZYAPPER_CORE_AI_RETRY_COUNT=3
# EZYAPPER_CORE_AI_TIMEOUT=30
# EZYAPPER_CORE_AI_MAX_TOOL_ITERATIONS=5
# EZYAPPER_CORE_AI_MAX_IMAGE_BYTES=10485760

# Vision configuration
# EZYAPPER_CORE_AI_VISION_MODE=text_only         # text_only | hybrid | multimodal
# EZYAPPER_CORE_AI_VISION_MODEL=gpt-4o
# EZYAPPER_CORE_AI_VISION_BASE64=true
# EZYAPPER_CORE_AI_VISION_MAX_IMAGES=4
# EZYAPPER_CORE_AI_VISION_DESCRIPTION_PROMPT=Describe this image in 1-2 sentences.
# EZYAPPER_CORE_AI_VISION_API_BASE_URL=
# EZYAPPER_CORE_AI_VISION_API_KEY=
# EZYAPPER_CORE_AI_VISION_MAX_TOKENS=
# EZYAPPER_CORE_AI_VISION_TEMPERATURE=
# EZYAPPER_CORE_AI_VISION_RETRY_COUNT=
# EZYAPPER_CORE_AI_VISION_TIMEOUT=

# ===========================================
# Decision Service (Optional)
# LLM-based reply decisions
# ===========================================

# EZYAPPER_CORE_DECISION_ENABLED=false
# EZYAPPER_CORE_DECISION_MODEL=gpt-4o-mini
# EZYAPPER_CORE_DECISION_API_BASE_URL=https://api.openai.com/v1
# EZYAPPER_CORE_DECISION_API_KEY=
# EZYAPPER_CORE_DECISION_MAX_TOKENS=64
# EZYAPPER_CORE_DECISION_TEMPERATURE=0.1
# EZYAPPER_CORE_DECISION_TIMEOUT=10
# EZYAPPER_CORE_DECISION_RETRY_COUNT=3

# ===========================================
# Embedding Configuration (Optional)
# Used for vector memory storage
# ===========================================

# EZYAPPER_MEMORY_PIPELINE_EMBEDDING_API_BASE_URL=
# EZYAPPER_MEMORY_PIPELINE_EMBEDDING_API_KEY=
# EZYAPPER_MEMORY_PIPELINE_EMBEDDING_MODEL=text-embedding-3-small
# EZYAPPER_MEMORY_PIPELINE_EMBEDDING_RETRY_COUNT=1
# EZYAPPER_MEMORY_PIPELINE_EMBEDDING_TIMEOUT=10

# ===========================================
# Memory Configuration (Optional)
# ===========================================

# Core memory tuning
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_INTERVAL=50
# EZYAPPER_MEMORY_PIPELINE_MEMORY_SHORT_TERM_LIMIT=20

# Memory retrieval
# EZYAPPER_MEMORY_PIPELINE_MEMORY_RETRIEVAL_TOP_K=5
# EZYAPPER_MEMORY_PIPELINE_MEMORY_RETRIEVAL_MIN_SCORE=0.75

# Memory consolidation (text model)
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_ENABLED=false
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_MODEL=
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_API_BASE_URL=
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_API_KEY=

# Memory consolidation (vision model — optional, inherits from core.ai.vision)
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_VISION_MODEL=
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_VISION_API_BASE_URL=
# EZYAPPER_MEMORY_PIPELINE_MEMORY_CONSOLIDATION_VISION_API_KEY=

# ===========================================
# Qdrant Configuration (Optional)
# Vector database for long-term memory
# ===========================================

# EZYAPPER_MEMORY_PIPELINE_QDRANT_HOST=qdrant
# EZYAPPER_MEMORY_PIPELINE_QDRANT_PORT=6334
# EZYAPPER_MEMORY_PIPELINE_QDRANT_API_KEY=
# EZYAPPER_MEMORY_PIPELINE_QDRANT_VECTOR_SIZE=1536

# ===========================================
# Discord Settings (Optional)
# ===========================================

# EZYAPPER_CORE_DISCORD_BOT_NAME=EZyapper
# EZYAPPER_CORE_DISCORD_OWN_BOT_ID=
# EZYAPPER_CORE_DISCORD_REPLY_PERCENTAGE=0.15
# EZYAPPER_CORE_DISCORD_COOLDOWN_SECONDS=5
# EZYAPPER_CORE_DISCORD_MAX_RESPONSES_PER_MINUTE=10
# EZYAPPER_CORE_DISCORD_OTHER_BOT_POLICY=ignore

# ===========================================
# WebUI Configuration (Optional)
# ===========================================

# EZYAPPER_OPERATIONS_WEB_ENABLED=false
# EZYAPPER_OPERATIONS_WEB_PORT=8080
# EZYAPPER_OPERATIONS_WEB_USERNAME=admin
# EZYAPPER_OPERATIONS_WEB_PASSWORD=changeme123

# ===========================================
# Logging Configuration (Optional)
# ===========================================

# EZYAPPER_OPERATIONS_LOGGING_LEVEL=info
# EZYAPPER_OPERATIONS_LOGGING_FILE=logs/ezyapper.log
# EZYAPPER_OPERATIONS_LOGGING_MAX_SIZE=100
# EZYAPPER_OPERATIONS_LOGGING_MAX_BACKUPS=3
# EZYAPPER_OPERATIONS_LOGGING_MAX_AGE=30

# ===========================================
# Plugin Settings (Optional)
# ===========================================

# EZYAPPER_OPERATIONS_PLUGINS_ENABLED=false
# EZYAPPER_OPERATIONS_PLUGINS_PLUGINS_DIR=plugins

# ===========================================
# Access Control (List-type values)
# These cannot be set via env vars - configure in config.yaml.
# Note: blacklist and whitelist for the same category are mutually exclusive.
# ===========================================

# ===========================================
# Docker-specific (not used by app directly)
# ===========================================

TZ=UTC
