{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/not-hanjo-mei/ezyapper/main/examples/config.schema.json",
  "title": "EZyapper Configuration",
  "description": "JSON Schema for config.yaml. Mirrors internal/config validation constraints.",
  "type": "object",
  "required": ["core", "memory_pipeline", "operations"],
  "additionalProperties": false,
  "properties": {
    "core": {
      "type": "object",
      "required": ["discord", "ai"],
      "additionalProperties": false,
      "properties": {
        "discord": {
          "type": "object",
          "required": ["token", "bot_name", "own_bot_id", "reply_percentage", "cooldown_seconds", "max_responses_per_minute", "rate_limit", "consolidation_timeout_sec", "typing_indicator_interval_sec", "long_response_delay_ms", "image_cache_ttl_min", "image_cache_max_entries", "other_bot_policy"],
          "additionalProperties": false,
          "properties": {
            "token":                    { "type": "string" },
            "bot_name":                 { "type": "string" },
            "own_bot_id":               { "type": "string", "$comment": "Stays in required even though some conditions (consolidation disabled, top_k=0) don't need it — JSON Schema can't express cross-subtree conditionals. Always provided for safety." },
            "reply_percentage":         { "type": "number", "minimum": 0, "maximum": 1 },
            "cooldown_seconds":         { "type": "integer", "minimum": 1 },
            "max_responses_per_minute": { "type": "integer", "minimum": 1 },
            "other_bot_policy":         { "type": "string", "enum": ["ignore", "context_only", "full"] },
            "rate_limit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reset_period_seconds"],
              "properties": {
                "reset_period_seconds": { "type": "integer", "minimum": 1 }
              }
            },
            "consolidation_timeout_sec":     { "type": "integer", "minimum": 1 },
            "typing_indicator_interval_sec": { "type": "integer", "minimum": 1 },
            "long_response_delay_ms":        { "type": "integer", "minimum": 1 },

            "image_cache_ttl_min":           { "type": "integer", "minimum": 1 },
            "image_cache_max_entries":       { "type": "integer", "minimum": 1 }
          }
        },
        "ai": {
          "type": "object",
          "required": ["api_base_url", "api_key", "model", "max_tokens", "temperature", "retry_count", "timeout", "system_prompt", "vision", "max_tool_iterations", "max_image_bytes"],
          "additionalProperties": false,
          "properties": {
            "api_base_url":   { "type": "string" },
            "api_key":        { "type": "string" },
            "model":          { "type": "string" },
            "max_tokens":     { "type": "integer", "minimum": 1 },
            "temperature":    { "type": "number", "minimum": 0, "maximum": 2 },
            "retry_count":    { "type": "integer", "minimum": 1 },
            "timeout":        { "type": "integer", "minimum": 1 },
            "max_tool_iterations":        { "type": "integer", "minimum": 1 },
            "max_image_bytes":            { "type": "integer", "minimum": 1 },
            "require_image_content_type": { "type": "boolean" },
            "system_prompt":  { "type": "string" },
            "extra_params":   { "type": "object" },
            "vision": {
              "type": "object",
              "required": ["mode"],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": { "mode": { "not": { "const": "text_only" } } },
                    "required": ["mode"]
                  },
                  "then": {
                    "required": ["model", "max_tokens", "retry_count", "timeout"]
                  }
                },
                {
                  "if": {
                    "properties": { "mode": { "const": "hybrid" } },
                    "required": ["mode"]
                  },
                  "then": {
                    "required": ["description_prompt"]
                  }
                }
              ],
              "properties": {
                "mode":               { "type": "string", "enum": ["text_only", "hybrid", "multimodal"] },
                "model":              { "type": "string" },
                "base64":             { "type": "boolean" },
                "max_images":         { "type": "integer", "minimum": 1 },
                "description_prompt": { "type": "string" },
                "api_base_url":       { "type": "string" },
                "api_key":            { "type": "string" },
                "max_tokens":         { "type": "integer", "minimum": 1 },
                "temperature":        { "type": "number", "minimum": 0, "maximum": 2 },
                "retry_count":        { "type": "integer", "minimum": 1 },
                "timeout":            { "type": "integer", "minimum": 1 },
                "extra_params":       { "type": "object" }
              }
            }
          }
        },
        "decision": {
          "type": "object",
          "required": ["enabled"],
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "required": ["model", "api_base_url", "api_key", "system_prompt", "max_tokens", "timeout"]
              }
            }
          ],
          "additionalProperties": false,
          "properties": {
            "enabled":       { "type": "boolean" },
            "model":         { "type": "string" },
            "api_base_url":  { "type": "string" },
            "api_key":       { "type": "string" },
            "max_tokens":    { "type": "integer", "minimum": 1 },
            "temperature":   { "type": "number", "minimum": 0, "maximum": 2 },
            "retry_count":   { "type": "integer", "minimum": 0 },
            "timeout":       { "type": "integer", "minimum": 1 },
            "system_prompt": { "type": "string" },
            "extra_params":  { "type": "object" }
          }
        }
      }
    },

    "memory_pipeline": {
      "type": "object",
      "required": ["embedding", "memory", "qdrant"],
      "additionalProperties": false,
      "properties": {
        "embedding": {
          "type": "object",
          "required": ["model", "timeout"],
          "additionalProperties": false,
          "properties": {
            "api_base_url": { "type": "string" },
            "api_key":      { "type": "string" },
            "model":        { "type": "string" },
            "retry_count":  { "type": "integer", "minimum": 0 },
            "timeout":      { "type": "integer", "minimum": 1 },
            "extra_params": { "type": "object" }
          }
        },
        "memory": {
          "type": "object",
          "required": ["consolidation_interval", "short_term_limit", "max_paginated_limit", "retrieval", "consolidation", "maintenance_interval_sec", "merge_cron_hour_utc", "summarize_cron_day", "merge_cosine_threshold", "prune_decay_threshold", "prune_age_days", "max_maintenance_llm_calls_per_day", "entropy_min_unique_word_ratio", "decay_rates", "scoring", "rrf_k", "context_max_memories"],
          "additionalProperties": false,
          "properties": {
            "consolidation_interval": { "type": "integer", "minimum": 1 },
            "short_term_limit":       { "type": "integer", "minimum": 1, "maximum": 500 },
            "max_paginated_limit":    { "type": "integer", "minimum": 1 },
            "retrieval": {
              "type": "object",
              "required": ["top_k", "min_score"],
              "additionalProperties": false,
              "properties": {
                "top_k":    { "type": "integer", "minimum": 0 },
                 "min_score": { "type": "number", "minimum": 0, "maximum": 1 },
                 "include_channel_memories": { "type": "boolean" },
                 "max_mentioned_memories": { "type": "integer", "minimum": 0 },
                 "max_channel_memories": { "type": "integer", "minimum": 0 }
               }
            },
            "consolidation": {
              "type": "object",
              "required": ["enabled", "memory_search_limit"],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": {
                    "required": ["model", "max_tokens", "retry_count", "timeout", "system_prompt"]
                  }
                }
              ],
              "properties": {
                "enabled":             { "type": "boolean" },
                "model":               { "type": "string" },
                "api_base_url":        { "type": "string" },
                "api_key":             { "type": "string" },
                "max_tokens":          { "type": "integer", "minimum": 1 },
                "temperature":         { "type": "number", "minimum": 0, "maximum": 2 },
                "retry_count":         { "type": "integer", "minimum": 0 },
                "timeout":             { "type": "integer", "minimum": 1 },
                "vision": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode":               { "type": "string", "enum": ["text_only", "hybrid", "multimodal"] },
                    "model":              { "type": "string" },
                    "base64":             { "type": "boolean" },
                    "api_base_url":       { "type": "string" },
                    "api_key":            { "type": "string" },
                    "max_tokens":         { "type": "integer", "minimum": 1 },
                    "temperature":        { "type": "number", "minimum": 0, "maximum": 2 },
                    "retry_count":        { "type": "integer", "minimum": 0 },
                    "timeout":            { "type": "integer", "minimum": 1 },
                    "description_prompt": { "type": "string" },
                    "extra_params":       { "type": "object" }
                  }
                },
                "system_prompt":       { "type": "string" },
                "extra_params":        { "type": "object" },
                "memory_search_limit": { "type": "integer", "minimum": 1 }
              }
             },
              "long_term_memory": {
                "type": "object",
                "additionalProperties": false,
                "required": ["enabled"],
                "properties": { "enabled": { "type": "boolean" } }
              },
              "max_mentioned_users_per_memory": { "type": "integer", "minimum": 0 },
              "memory_strength_multiplier": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "relationship_prune_age_days": { "type": "integer", "minimum": 1 },
              "maintenance_interval_sec": { "type": "integer", "minimum": 1 },
             "merge_cron_hour_utc": { "type": "integer", "minimum": 0, "maximum": 23 },
             "summarize_cron_day": { "type": "integer", "minimum": 0, "maximum": 6 },
             "merge_cosine_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
             "prune_decay_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
             "prune_age_days": { "type": "integer", "minimum": 1 },
             "max_maintenance_llm_calls_per_day": { "type": "integer", "minimum": 0 },

             "entropy_min_unique_word_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
             "decay_rates": {
               "type": "object",
               "additionalProperties": false,
               "required": ["fact", "episode", "interest", "summary"],
               "properties": {
                 "fact": { "type": "number", "exclusiveMinimum": 0 },
                 "episode": { "type": "number", "exclusiveMinimum": 0 },
                 "interest": { "type": "number", "exclusiveMinimum": 0 },
                 "summary": { "type": "number", "exclusiveMinimum": 0 }
               }
             },
             "scoring": {
               "type": "object", "additionalProperties": false,
               "required": ["importance_weight", "recency_weight", "access_weight", "confidence_weight"],
               "properties": {
                 "importance_weight": { "type": "number", "minimum": 0 },
                 "recency_weight": { "type": "number", "minimum": 0 },
                 "access_weight": { "type": "number", "minimum": 0 },
                 "confidence_weight": { "type": "number", "minimum": 0 }
               }
             },
             "rrf_k": { "type": "integer", "minimum": 1 },
             "context_max_memories": { "type": "integer", "minimum": 1 }
           }
         },
         "qdrant": {
          "type": "object",
          "required": ["host", "port", "vector_size"],
           "additionalProperties": false,
           "properties": {
             "host":              { "type": "string" },
             "port":              { "type": "integer", "minimum": 1, "maximum": 65535 },
             "api_key":           { "type": "string" },
             "vector_size":       { "type": "integer", "minimum": 1 },
             "retry_base_delay_ms": { "type": "integer", "minimum": 1 },
             "retry_max_delay_ms":  { "type": "integer", "minimum": 1 },
             "max_retries":         { "type": "integer", "minimum": 1 }
           }
        }
      }
    },

    "access_control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blacklist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "users":    { "type": "array", "items": { "anyOf": [{"type": "string"}, {"type": "integer"}] } },
            "guilds":   { "type": "array", "items": { "anyOf": [{"type": "string"}, {"type": "integer"}] } },
            "channels": { "type": "array", "items": { "anyOf": [{"type": "string"}, {"type": "integer"}] } }
          }
        },
        "whitelist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "users":    { "type": "array", "items": { "anyOf": [{"type": "string"}, {"type": "integer"}] } },
            "guilds":   { "type": "array", "items": { "anyOf": [{"type": "string"}, {"type": "integer"}] } },
            "channels": { "type": "array", "items": { "anyOf": [{"type": "string"}, {"type": "integer"}] } }
          }
        }
      }
    },

    "operations": {
      "type": "object",
          "required": ["web", "logging", "plugins", "runtime"],
          "additionalProperties": false,
          "properties": {
        "web": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "required": ["port", "username", "password", "memories_page_limit", "session_ttl_min", "session_cleanup_interval_min", "stats_query_timeout_sec", "log_default_lines", "log_max_lines", "log_max_read_bytes"]
              }
            }
          ],
          "properties": {
            "port":     { "type": "integer", "minimum": 1, "maximum": 65535 },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "enabled":  { "type": "boolean" },
            "memories_page_limit":          { "type": "integer", "minimum": 1 },

            "session_ttl_min":              { "type": "integer", "minimum": 1 },
            "session_cleanup_interval_min": { "type": "integer", "minimum": 1 },
            "stats_query_timeout_sec":      { "type": "integer", "minimum": 1 },
            "log_default_lines":            { "type": "integer", "minimum": 1 },
            "log_max_lines":                { "type": "integer", "minimum": 1 },
            "log_max_read_bytes":           { "type": "integer", "minimum": 1 }
          }
        },
        "logging": {
          "type": "object",
          "required": ["level", "file", "max_size", "max_backups", "max_age"],
          "additionalProperties": false,
          "properties": {
            "level":       { "type": "string", "enum": ["debug", "info", "warn", "error"] },
            "file":        { "type": "string" },
            "max_size":    { "type": "integer", "minimum": 1 },
            "max_backups": { "type": "integer", "minimum": 1 },
            "max_age":     { "type": "integer", "minimum": 1 }
          }
        },
        "plugins": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "required": ["plugins_dir", "default_tool_timeout_ms", "startup_timeout_sec", "rpc_timeout_sec", "before_send_timeout_sec", "command_timeout_sec", "shutdown_timeout_sec", "disable_timeout_sec"]
              }
            }
          ],
          "properties": {
            "enabled":     { "type": "boolean" },
            "plugins_dir": { "type": "string" },
            "default_tool_timeout_ms":  { "type": "integer", "minimum": 0 },
            "startup_timeout_sec":      { "type": "integer", "minimum": 1 },
            "rpc_timeout_sec":          { "type": "integer", "minimum": 1 },
            "before_send_timeout_sec":  { "type": "integer", "minimum": 1 },
            "command_timeout_sec":      { "type": "integer", "minimum": 1 },
            "shutdown_timeout_sec":     { "type": "integer", "minimum": 1 },
            "disable_timeout_sec":      { "type": "integer", "minimum": 1 }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "required": ["servers"]
              }
            }
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "servers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "type"],
                "additionalProperties": false,
                "properties": {
                  "name":    { "type": "string" },
                  "type":    { "type": "string", "enum": ["stdio", "sse"] },
                  "command": { "type": "string" },
                  "args":    { "type": "array", "items": {"type": "string"} },
                  "env":     { "type": "object" },
                  "url":     { "type": "string" }
                }
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shutdown_timeout_sec", "cleanup_interval_min"],
          "properties": {
            "shutdown_timeout_sec": { "type": "integer", "minimum": 1 },
            "cleanup_interval_min": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
