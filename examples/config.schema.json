{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/not-hanjo-mei/ezyapper/main/examples/config.schema.json",
  "title": "EZyapper Configuration",
  "description": "JSON Schema for config.yaml. The bot has no built-in defaults: values under \"examples\" are suggestions (they match examples/config.yaml.example), never filled in by the loader. Mirrors internal/config validation: a key is listed as required when the bot refuses to start without it (a key whose zero value is valid, such as reply_percentage or temperature, is optional). Conditional requirements (memory on, web/plugins/mcp/decision enabled) follow the Go validators.",
  "type": "object",
  "required": ["core", "memory_pipeline", "operations"],
  "additionalProperties": false,
  "$defs": {
    "id":       { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
    "idList":   { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "nonEmpty": { "type": "array", "minItems": 1 },
    "memoryEnabled": {
      "$comment": "Memory is on when memory.retrieval.top_k > 0 or memory.consolidation.enabled is true (evaluated against memory_pipeline).",
      "anyOf": [
        { "required": ["memory"], "properties": { "memory": { "required": ["retrieval"], "properties": { "retrieval": { "required": ["top_k"], "properties": { "top_k": { "minimum": 1 } } } } } } },
        { "required": ["memory"], "properties": { "memory": { "required": ["consolidation"], "properties": { "consolidation": { "required": ["enabled"], "properties": { "enabled": { "const": true } } } } } } }
      ]
    },
    "kinds": { "type": "array", "items": { "type": "string", "enum": ["text", "embed", "image", "sticker", "audio", "voice", "video", "file", "reply", "bot", "webhook"] } }
  },
  "allOf": [
    {
      "$comment": "core.discord.own_bot_id is required when memory retrieval or consolidation is on.",
      "if": { "required": ["memory_pipeline"], "properties": { "memory_pipeline": { "$ref": "#/$defs/memoryEnabled" } } },
      "then": { "properties": { "core": { "properties": { "discord": { "required": ["own_bot_id"] } } } } }
    }
  ],
  "properties": {
    "core": {
      "type": "object",
      "required": ["discord", "ai"],
      "additionalProperties": false,
      "properties": {
        "discord": {
          "type": "object",
          "required": ["token", "bot_name", "cooldown_seconds", "max_responses_per_minute", "rate_limit", "consolidation_timeout_sec", "typing_indicator_interval_sec", "long_response_delay_ms", "image_cache_ttl_min", "image_cache_max_entries", "other_bot_policy"],
          "additionalProperties": false,
          "properties": {
            "token":                    { "type": "string", "minLength": 1 },
            "bot_name":                 { "type": "string", "minLength": 1 },
            "own_bot_id":               { "type": "string", "description": "The bot's user ID. Required when memory retrieval (top_k > 0) or consolidation is enabled." },
            "reply_percentage":         { "type": "number", "minimum": 0, "maximum": 1 },
            "cooldown_seconds":         { "type": "integer", "minimum": 1, "description": "Per-user cooldown after each reply (all channels)." },
            "max_responses_per_minute": { "type": "integer", "minimum": 1, "description": "Replies per user per channel within rate_limit.reset_period_seconds." },
            "other_bot_policy":         { "type": "string", "enum": ["ignore", "context_only", "full"] },
            "rate_limit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reset_period_seconds"],
              "properties": {
                "reset_period_seconds": { "type": "integer", "minimum": 1 }
              }
            },
            "consolidation_timeout_sec":     { "type": "integer", "minimum": 1 },
            "typing_indicator_interval_sec": { "type": "integer", "minimum": 1 },
            "long_response_delay_ms":        { "type": "integer", "minimum": 1, "description": "Pause between the chunks of a reply split for Discord's length limit." },
            "image_cache_ttl_min":           { "type": "integer", "minimum": 1, "description": "TTL of the media cache (image descriptions, audio transcripts, video descriptions)." },
            "image_cache_max_entries":       { "type": "integer", "minimum": 1, "description": "Size bound of the media cache." },
            "clear_command": {
              "type": "object",
              "additionalProperties": false,
              "description": "Optional /clear-context slash command; only allowed_user_ids may run it.",
              "allOf": [{ "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["allowed_user_ids"], "properties": { "allowed_user_ids": { "minItems": 1 } } } }],
              "properties": {
                "enabled":          { "type": "boolean" },
                "allowed_user_ids": { "$ref": "#/$defs/idList" }
              }
            }
          }
        },
        "ai": {
          "type": "object",
          "required": ["api_base_url", "api_key", "model", "max_tokens", "retry_count", "timeout", "system_prompt", "max_tool_iterations", "max_image_bytes", "modalities"],
          "additionalProperties": false,
          "properties": {
            "api_base_url":   { "type": "string", "minLength": 1 },
            "api_key":        { "type": "string", "minLength": 1 },
            "model":          { "type": "string", "minLength": 1 },
            "max_tokens":     { "type": "integer", "minimum": 1 },
            "temperature":    { "type": "number", "minimum": 0, "maximum": 2 },
            "retry_count":    { "type": "integer", "minimum": 1 },
            "timeout":        { "type": "integer", "minimum": 1, "description": "Per-request timeout (s); also used by a modality that sets none." },
            "max_tool_iterations":        { "type": "integer", "minimum": 1 },
            "max_image_bytes":            { "type": "integer", "minimum": 1 },
            "require_image_content_type": { "type": "boolean", "deprecated": true, "description": "Removed and ignored (a config that sets it logs a deprecation warning)." },
            "system_prompt":  { "type": "string", "minLength": 1, "not": { "pattern": "\\{(BotName|AuthorName|ServerName|GuildID|ChannelID)\\}" }, "description": "Sent unchanged; the removed {BotName}-style placeholders fail validation." },
            "extra_params":   { "type": "object" },
            "modalities": {
              "type": "object",
              "description": "Per-modality models that turn media into text. Text is always core.ai, which is text-only (the reply request never carries media). Empty endpoint fields fall back to core.ai. Every other key an enabled modality uses is required (no built-in defaults); sticker.max_items/cache_ttl_min/cache_max_entries are always required because stickers are always annotated.",
              "additionalProperties": false,
              "required": ["sticker"],
              "allOf": [
                { "if": { "required": ["audio"], "properties": { "audio": { "required": ["enabled", "transcode"], "properties": { "enabled": { "const": true }, "transcode": { "enum": ["mp3", "wav"] } } } } }, "then": { "required": ["ffmpeg_path"] } },
                { "if": { "required": ["video"], "properties": { "video": { "required": ["enabled", "transcode"], "properties": { "enabled": { "const": true }, "transcode": { "const": true } } } } }, "then": { "required": ["ffmpeg_path"] } }
              ],
              "properties": {
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "allOf": [{ "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["model", "prompt", "max_items", "transport"], "properties": { "prompt": { "minLength": 1 }, "max_items": { "minimum": 1 } } } }],
                  "properties": {
                    "enabled":      { "type": "boolean" },
                    "mode":         { "not": {}, "deprecated": true, "description": "Removed: images are always described into text by the image model. A config that sets it fails validation." },
                    "model":        { "type": "string" },
                    "api_base_url": { "type": "string" },
                    "api_key":      { "type": "string" },
                    "timeout":      { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.timeout. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "max_tokens":   { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.max_tokens. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "temperature":  { "type": "number", "minimum": 0, "maximum": 2, "description": "Absent: inherits core.ai.temperature. An explicit value, including 0, is used as is." },
                    "retry_count":  { "type": "integer", "minimum": 0, "description": "Absent: inherits core.ai.retry_count. An explicit value, including 0 (no retries), is used as is." },
                    "extra_params": { "type": "object", "description": "Absent: inherits core.ai.extra_params. An explicit map is used as is; {} sends none." },
                    "prompt":       { "type": "string" },
                    "max_items":    { "type": "integer", "minimum": 0, "examples": [4] },
                    "transport":    { "type": "string", "enum": ["base64", "url"], "examples": ["base64"] }
                  }
                },
                "audio": {
                  "type": "object",
                  "additionalProperties": false,
                  "allOf": [
                    { "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["model", "mode", "max_items", "max_bytes", "max_duration_sec"], "properties": { "max_items": { "minimum": 1 }, "max_bytes": { "minimum": 1 }, "max_duration_sec": { "minimum": 1 } } } },
                    { "if": { "properties": { "enabled": { "const": true }, "mode": { "const": "describe" } }, "required": ["enabled", "mode"] }, "then": { "required": ["prompt", "part_type"], "properties": { "prompt": { "minLength": 1 } } } },
                    { "if": { "properties": { "part_type": { "const": "input_audio" } }, "required": ["part_type"] }, "then": { "required": ["transcode"], "properties": { "transcode": { "enum": ["mp3", "wav"] } } } }
                  ],
                  "properties": {
                    "enabled":          { "type": "boolean" },
                    "mode":             { "type": "string", "enum": ["asr", "describe"], "examples": ["asr"], "description": "asr: /audio/transcriptions endpoint; describe: audio-capable chat model. The old \"direct\" mode was removed and fails validation." },
                    "model":            { "type": "string" },
                    "api_base_url":     { "type": "string" },
                    "api_key":          { "type": "string" },
                    "timeout":          { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.timeout. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "max_tokens":       { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.max_tokens. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "temperature":      { "type": "number", "minimum": 0, "maximum": 2, "description": "Absent: inherits core.ai.temperature. An explicit value, including 0, is used as is." },
                    "retry_count":      { "type": "integer", "minimum": 0, "description": "Absent: inherits core.ai.retry_count. An explicit value, including 0 (no retries), is used as is." },
                    "extra_params":     { "type": "object", "description": "Absent: inherits core.ai.extra_params. An explicit map is used as is; {} sends none." },
                    "language":         { "type": "string" },
                    "prompt":           { "type": "string" },
                    "max_items":        { "type": "integer", "minimum": 0, "examples": [2] },
                    "max_bytes":        { "type": "integer", "minimum": 0, "examples": [26214400] },
                    "max_duration_sec": { "type": "integer", "minimum": 0, "examples": [600] },
                    "transcode":        { "type": "string", "enum": ["", "mp3", "wav"], "description": "Convert with ffmpeg before sending (requires ffmpeg)." },
                    "part_type":        { "type": "string", "enum": ["audio_url", "input_audio"], "examples": ["audio_url"] }
                  }
                },
                "video": {
                  "type": "object",
                  "additionalProperties": false,
                  "allOf": [
                    { "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["model", "prompt", "max_items", "max_bytes", "max_duration_sec", "transport"], "properties": { "prompt": { "minLength": 1 }, "max_items": { "minimum": 1 }, "max_bytes": { "minimum": 1 }, "max_duration_sec": { "minimum": 1 } } } },
                    { "if": { "properties": { "enabled": { "const": true }, "transcode": { "const": true } }, "required": ["enabled", "transcode"] }, "then": { "required": ["max_height"], "properties": { "max_height": { "minimum": 1 } } } },
                    { "if": { "properties": { "transcode": { "const": true } }, "required": ["transcode"] }, "then": { "properties": { "transport": { "const": "base64" } } } }
                  ],
                  "properties": {
                    "enabled":          { "type": "boolean" },
                    "mode":             { "not": {}, "deprecated": true, "description": "Removed: videos are always described into text by the video model. A config that sets it fails validation." },
                    "model":            { "type": "string" },
                    "api_base_url":     { "type": "string" },
                    "api_key":          { "type": "string" },
                    "timeout":          { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.timeout. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "max_tokens":       { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.max_tokens. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "temperature":      { "type": "number", "minimum": 0, "maximum": 2, "description": "Absent: inherits core.ai.temperature. An explicit value, including 0, is used as is." },
                    "retry_count":      { "type": "integer", "minimum": 0, "description": "Absent: inherits core.ai.retry_count. An explicit value, including 0 (no retries), is used as is." },
                    "extra_params":     { "type": "object", "description": "Absent: inherits core.ai.extra_params. An explicit map is used as is; {} sends none." },
                    "prompt":           { "type": "string" },
                    "max_items":        { "type": "integer", "minimum": 0, "examples": [1] },
                    "max_bytes":        { "type": "integer", "minimum": 0, "examples": [52428800] },
                    "max_duration_sec": { "type": "integer", "minimum": 0, "examples": [120] },
                    "transport":        { "type": "string", "enum": ["base64", "url"], "examples": ["base64"] },
                    "transcode":        { "type": "boolean", "description": "Re-encode with ffmpeg (requires ffmpeg and transport base64)." },
                    "max_height":       { "type": "integer", "minimum": 0, "examples": [480] }
                  }
                },
                "sticker": {
                  "type": "object",
                  "additionalProperties": false,
                  "$comment": "enabled: true (vision) needs a model from sticker.model or image.model (not expressible here; the Go loader checks it).",
                  "required": ["max_items", "cache_ttl_min", "cache_max_entries"],
                  "allOf": [{ "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["prompt"], "properties": { "prompt": { "minLength": 1 } } } }],
                  "properties": {
                    "enabled":           { "type": "boolean", "description": "true: a vision model describes the sticker image (Lottie falls back to text); false: Discord name/description/tags only, no model call." },
                    "mode":              { "type": "string", "deprecated": true, "description": "Removed and ignored (a config that sets it logs a deprecation warning); sticker.enabled is the only switch." },
                    "model":             { "type": "string" },
                    "api_base_url":      { "type": "string" },
                    "api_key":           { "type": "string" },
                    "timeout":           { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.modalities.image.timeout (then core.ai.timeout). An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "max_tokens":        { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.modalities.image.max_tokens (then core.ai.max_tokens). An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "temperature":       { "type": "number", "minimum": 0, "maximum": 2, "description": "Absent: inherits core.ai.modalities.image.temperature (then core.ai.temperature). An explicit value, including 0, is used as is." },
                    "retry_count":       { "type": "integer", "minimum": 0, "description": "Absent: inherits core.ai.modalities.image.retry_count (then core.ai.retry_count). An explicit value, including 0 (no retries), is used as is." },
                    "extra_params":      { "type": "object", "description": "Absent: inherits core.ai.modalities.image.extra_params (then core.ai.extra_params). An explicit map is used as is; {} sends none." },
                    "prompt":            { "type": "string" },
                    "max_items":         { "type": "integer", "minimum": 1, "examples": [3] },
                    "cache_ttl_min":     { "type": "integer", "minimum": 1, "examples": [1440] },
                    "cache_max_entries": { "type": "integer", "minimum": 1, "examples": [1000] }
                  }
                },
                "ffmpeg_path": { "type": "string", "minLength": 1, "examples": ["ffmpeg"], "description": "ffmpeg binary (name looked up in PATH, or a path). Required when audio.transcode or video.transcode is on." }
              }
            },
            "vision": {
              "type": "object",
              "deprecated": true,
              "description": "Deprecated: mapped onto modalities.image at load (text_only or empty mode = image off; hybrid and multimodal = image described by vision.model). Ignored when modalities.image is set. The mapped image modality needs description_prompt and max_images (no built-in defaults).",
              "additionalProperties": false,
              "properties": {
                "mode":               { "type": "string", "enum": ["", "text_only", "hybrid", "multimodal"] },
                "model":              { "type": "string" },
                "base64":             { "type": "boolean", "description": "true = transport base64, false = transport url." },
                "max_images":         { "type": "integer", "minimum": 0 },
                "description_prompt": { "type": "string" },
                "api_base_url":       { "type": "string" },
                "api_key":            { "type": "string" },
                "max_tokens":         { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.max_tokens. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                "temperature":        { "type": "number", "minimum": 0, "maximum": 2, "description": "Absent: inherits core.ai.temperature. An explicit value, including 0, is used as is." },
                "retry_count":        { "type": "integer", "minimum": 0, "description": "Absent: inherits core.ai.retry_count. An explicit value, including 0 (no retries), is used as is." },
                "timeout":            { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.timeout. An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                "extra_params":       { "type": "object", "description": "Absent: inherits core.ai.extra_params. An explicit map is used as is; {} sends none." }
              }
            }
          }
        },
        "decision": {
          "type": "object",
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "required": ["provider"] }
            },
            {
              "if": {
                "properties": { "enabled": { "const": true }, "provider": { "const": "llm" } },
                "required": ["enabled", "provider"]
              },
              "then": {
                "required": ["model", "api_base_url", "api_key", "system_prompt", "max_tokens", "timeout"]
              }
            },
            {
              "if": {
                "properties": { "enabled": { "const": true }, "provider": { "const": "system_one" } },
                "required": ["enabled", "provider"]
              },
              "then": { "required": ["system_one"] }
            }
          ],
          "additionalProperties": false,
          "properties": {
            "enabled":       { "type": "boolean" },
            "provider":      { "type": "string", "enum": ["llm", "system_one"], "description": "Required when enabled (no default provider)." },
            "model":         { "type": "string" },
            "api_base_url":  { "type": "string" },
            "api_key":       { "type": "string" },
            "max_tokens":    { "type": "integer", "minimum": 1 },
            "temperature":   { "type": "number", "minimum": 0, "maximum": 2 },
            "retry_count":   { "type": "integer", "minimum": 0 },
            "timeout":       { "type": "integer", "minimum": 1 },
            "system_prompt": { "type": "string", "not": { "pattern": "\\{(BotName|AuthorName|ServerName|GuildID|ChannelID)\\}" } },
            "extra_params":  { "type": "object" },
            "system_one": {
              "type": "object",
              "required": ["api_base_url", "api_key", "model", "timeout", "threshold", "instructions", "max_state_bytes"],
              "dependentRequired": { "criteria_true": ["criteria_false"], "criteria_false": ["criteria_true"] },
              "additionalProperties": false,
              "properties": {
                "api_base_url":    { "type": "string" },
                "api_key":         { "type": "string" },
                "model":           { "type": "string" },
                "timeout":         { "type": "integer", "minimum": 1 },
                "retry_count":     { "type": "integer", "minimum": 0 },
                "threshold":       { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "description": "Reply only when P(yes) > 0.5 (Jev says yes) and P(yes) > threshold." },
                "instructions":    { "type": "string", "minLength": 1 },
                "criteria_true":   { "type": "string" },
                "criteria_false":  { "type": "string" },
                "max_state_bytes": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },

    "memory_pipeline": {
      "type": "object",
      "required": ["memory"],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "Embedding and Qdrant settings are only required when memory retrieval or consolidation is on.",
          "if": { "$ref": "#/$defs/memoryEnabled" },
          "then": {
            "required": ["embedding", "qdrant"],
            "properties": {
              "embedding": { "required": ["model", "timeout"] },
              "qdrant":    { "required": ["host", "port", "vector_size", "retry_base_delay_ms", "retry_max_delay_ms", "max_retries"] }
            }
          }
        }
      ],
      "properties": {
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api_base_url": { "type": "string", "description": "Empty = core.ai.api_base_url." },
            "api_key":      { "type": "string", "description": "Empty = core.ai.api_key." },
            "model":        { "type": "string" },
            "retry_count":  { "type": "integer", "minimum": 0 },
            "timeout":      { "type": "integer", "minimum": 1 },
            "extra_params": { "type": "object", "description": "Absent: inherits core.ai.extra_params (chat-only parameters there are then sent to the embedding endpoint too). An explicit map is used as is; {} sends none." }
          }
        },
        "memory": {
          "type": "object",
          "required": ["consolidation_interval", "short_term_limit", "max_paginated_limit", "consolidation", "memory_strength_multiplier", "maintenance_interval_sec", "prune_age_days", "relationship_prune_age_days", "decay_rates", "rrf_k", "context_max_memories"],
          "additionalProperties": false,
          "properties": {
            "consolidation_interval": { "type": "integer", "minimum": 1 },
            "short_term_limit":       { "type": "integer", "minimum": 1 },
            "context_flush_window":   { "type": "integer", "minimum": 0, "examples": [0] },
            "max_paginated_limit":    { "type": "integer", "minimum": 1 },
            "retrieval": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "top_k":                    { "type": "integer", "minimum": 0, "description": "0 disables retrieval." },
                "min_score":                { "type": "number", "minimum": 0, "maximum": 1 },
                "include_channel_memories": { "type": "boolean" },
                "max_mentioned_memories":   { "type": "integer", "minimum": 0, "description": "Absent: inherits retrieval.top_k. An explicit value is used as is; 0 = none." },
                "max_channel_memories":     { "type": "integer", "minimum": 0, "description": "Absent: inherits retrieval.top_k. An explicit value is used as is; 0 = none." }
              }
            },
            "consolidation": {
              "type": "object",
              "required": ["memory_search_limit"],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": {
                    "required": ["max_tokens", "retry_count", "timeout", "system_prompt"],
                    "properties": { "retry_count": { "minimum": 1 }, "system_prompt": { "minLength": 1 } }
                  }
                }
              ],
              "properties": {
                "enabled":             { "type": "boolean" },
                "model":               { "type": "string", "description": "Empty = core.ai.model." },
                "api_base_url":        { "type": "string", "description": "Empty = core.ai.api_base_url." },
                "api_key":             { "type": "string", "description": "Empty = core.ai.api_key." },
                "max_tokens":          { "type": "integer", "minimum": 1 },
                "temperature":         { "type": "number", "minimum": 0, "maximum": 2, "description": "Absent: inherits core.ai.temperature. An explicit value, including 0, is used as is." },
                "retry_count":         { "type": "integer", "minimum": 0 },
                "timeout":             { "type": "integer", "minimum": 1 },
                "vision": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Optional overrides for describing images during consolidation. Absent keys (and empty strings) use core.ai.modalities.image (then core.ai); an explicit value, including 0 or {}, is used as is. Only used when the image modality is enabled.",
                  "properties": {
                    "model":              { "type": "string" },
                    "api_base_url":       { "type": "string" },
                    "api_key":            { "type": "string" },
                    "max_tokens":         { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.modalities.image.max_tokens (then core.ai.max_tokens). An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "temperature":        { "type": "number", "minimum": 0, "maximum": 2, "description": "Absent: inherits core.ai.modalities.image.temperature (then core.ai.temperature). An explicit value, including 0, is used as is." },
                    "retry_count":        { "type": "integer", "minimum": 0, "description": "Absent: inherits core.ai.modalities.image.retry_count (then core.ai.retry_count). An explicit value, including 0 (no retries), is used as is." },
                    "timeout":            { "type": "integer", "minimum": 1, "description": "Absent: inherits core.ai.modalities.image.timeout (then core.ai.timeout). An explicit value is used as is; 0 is rejected (remove the key to inherit)." },
                    "description_prompt": { "type": "string" },
                    "mode":               { "type": "string", "deprecated": true, "description": "Ignored." },
                    "base64":             { "type": "boolean", "deprecated": true, "description": "Ignored (the image modality's transport is used)." },
                    "max_images":         { "type": "integer", "deprecated": true, "description": "Ignored (the image modality's max_items is used)." },
                    "extra_params":       { "type": "object", "description": "Absent: inherits core.ai.modalities.image.extra_params (then core.ai.extra_params). An explicit map is used as is; {} sends none." }
                  }
                },
                "system_prompt":       { "type": "string" },
                "extra_params":        { "type": "object", "description": "Not inherited from core.ai." },
                "memory_search_limit": { "type": "integer", "minimum": 1 }
              }
            },
            "long_term_memory": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "enabled": { "type": "boolean", "description": "Accepted but currently not read by the bot." } }
            },
            "max_mentioned_users_per_memory": { "type": "integer", "minimum": 0, "description": "Accepted but currently not read by the bot." },
            "memory_strength_multiplier":     { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
            "maintenance_interval_sec":       { "type": "integer", "minimum": 1 },
            "merge_cron_hour_utc":            { "type": "integer", "minimum": 0, "maximum": 23 },
            "summarize_cron_day":             { "type": "integer", "minimum": 0, "maximum": 6 },
            "merge_cosine_threshold":         { "type": "number", "minimum": 0, "maximum": 1 },
            "prune_decay_threshold":          { "type": "number", "minimum": 0, "maximum": 1 },
            "prune_age_days":                 { "type": "integer", "minimum": 1 },
            "relationship_prune_age_days":    { "type": "integer", "minimum": 1 },
            "max_maintenance_llm_calls_per_day": { "type": "integer", "minimum": 0 },
            "entropy_min_unique_word_ratio":  { "type": "number", "minimum": 0, "maximum": 1 },
            "decay_rates": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact", "episode", "interest", "summary"],
              "properties": {
                "fact":     { "type": "number", "exclusiveMinimum": 0 },
                "episode":  { "type": "number", "exclusiveMinimum": 0 },
                "interest": { "type": "number", "exclusiveMinimum": 0 },
                "summary":  { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "scoring": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "importance_weight": { "type": "number", "minimum": 0 },
                "recency_weight":    { "type": "number", "minimum": 0 },
                "access_weight":     { "type": "number", "minimum": 0 },
                "confidence_weight": { "type": "number", "minimum": 0 }
              }
            },
            "rrf_k":                { "type": "integer", "minimum": 1 },
            "context_max_memories": { "type": "integer", "minimum": 1 }
          }
        },
        "qdrant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host":                { "type": "string", "minLength": 1 },
            "port":                { "type": "integer", "minimum": 1, "maximum": 65535, "description": "gRPC port (Qdrant's default is 6334)." },
            "api_key":             { "type": "string" },
            "vector_size":         { "type": "integer", "minimum": 1 },
            "retry_base_delay_ms": { "type": "integer", "minimum": 1 },
            "retry_max_delay_ms":  { "type": "integer", "minimum": 1 },
            "max_retries":         { "type": "integer", "minimum": 1 }
          }
        }
      }
    },

    "access_control": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Blacklist and whitelist cannot both be non-empty for the same category.",
      "allOf": [
        { "not": { "required": ["blacklist", "whitelist"], "properties": { "blacklist": { "required": ["users"], "properties": { "users": { "$ref": "#/$defs/nonEmpty" } } }, "whitelist": { "required": ["users"], "properties": { "users": { "$ref": "#/$defs/nonEmpty" } } } } } },
        { "not": { "required": ["blacklist", "whitelist"], "properties": { "blacklist": { "required": ["guilds"], "properties": { "guilds": { "$ref": "#/$defs/nonEmpty" } } }, "whitelist": { "required": ["guilds"], "properties": { "guilds": { "$ref": "#/$defs/nonEmpty" } } } } } },
        { "not": { "required": ["blacklist", "whitelist"], "properties": { "blacklist": { "required": ["channels"], "properties": { "channels": { "$ref": "#/$defs/nonEmpty" } } }, "whitelist": { "required": ["channels"], "properties": { "channels": { "$ref": "#/$defs/nonEmpty" } } } } } }
      ],
      "properties": {
        "blacklist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "users":    { "$ref": "#/$defs/idList" },
            "guilds":   { "$ref": "#/$defs/idList" },
            "channels": { "$ref": "#/$defs/idList" }
          }
        },
        "whitelist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "users":    { "$ref": "#/$defs/idList" },
            "guilds":   { "$ref": "#/$defs/idList" },
            "channels": { "$ref": "#/$defs/idList" }
          }
        },
        "message_filters": {
          "type": "object",
          "additionalProperties": false,
          "description": "Regex allow/ignore rules for incoming messages. First matching rule wins; ignored messages are not answered and are hidden from context and consolidation. The bot's own messages are never filtered.",
          "allOf": [{ "if": { "required": ["rules"], "properties": { "rules": { "minItems": 1 } } }, "then": { "required": ["default_action"] } }],
          "properties": {
            "default_action": { "type": "string", "enum": ["allow", "ignore"], "examples": ["allow"], "description": "Required when rules are set (no built-in default)." },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action"],
                "anyOf": [
                  { "required": ["guild"] }, { "required": ["channel"] }, { "required": ["user"] }, { "required": ["username"] },
                  { "required": ["content"] }, { "required": ["kinds"] }, { "required": ["kinds_all"] }
                ],
                "properties": {
                  "name":      { "type": "string", "description": "Label shown in logs when the rule matches." },
                  "action":    { "type": "string", "enum": ["allow", "ignore"] },
                  "guild":     { "type": "string", "description": "Regex searched in the guild ID (anchor with ^...$ for exact)." },
                  "channel":   { "type": "string", "description": "Regex searched in the channel ID." },
                  "user":      { "type": "string", "description": "Regex searched in the author ID." },
                  "username":  { "type": "string", "description": "Regex searched in the author username." },
                  "content":   { "type": "string", "description": "Regex searched in the message text plus rendered embeds." },
                  "kinds":     { "$ref": "#/$defs/kinds", "description": "Matches when the message has ANY of these kinds." },
                  "kinds_all": { "$ref": "#/$defs/kinds", "description": "Matches when the message has ALL of these kinds." }
                }
              }
            }
          }
        }
      }
    },

    "operations": {
      "type": "object",
      "required": ["logging", "runtime"],
      "additionalProperties": false,
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "required": ["port", "username", "password", "memories_page_limit", "session_ttl_min", "session_cleanup_interval_min", "stats_query_timeout_sec", "log_default_lines", "log_max_lines", "log_max_read_bytes"]
              }
            }
          ],
          "properties": {
            "enabled":  { "type": "boolean" },
            "port":     { "type": "integer", "minimum": 1, "maximum": 65535 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 },
            "memories_page_limit":          { "type": "integer", "minimum": 1 },
            "session_ttl_min":              { "type": "integer", "minimum": 1 },
            "session_cleanup_interval_min": { "type": "integer", "minimum": 1 },
            "stats_query_timeout_sec":      { "type": "integer", "minimum": 1 },
            "log_default_lines":            { "type": "integer", "minimum": 1 },
            "log_max_lines":                { "type": "integer", "minimum": 1 },
            "log_max_read_bytes":           { "type": "integer", "minimum": 1 }
          }
        },
        "logging": {
          "type": "object",
          "required": ["level", "file", "max_size", "max_backups", "max_age"],
          "additionalProperties": false,
          "properties": {
            "level":       { "type": "string", "enum": ["debug", "info", "warn", "error", "dpanic", "panic", "fatal", "DEBUG", "INFO", "WARN", "ERROR", "DPANIC", "PANIC", "FATAL"], "description": "Parsed by zapcore.ParseLevel." },
            "file":        { "type": "string", "minLength": 1 },
            "max_size":    { "type": "integer", "minimum": 1 },
            "max_backups": { "type": "integer", "minimum": 1 },
            "max_age":     { "type": "integer", "minimum": 1 }
          }
        },
        "plugins": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "required": ["plugins_dir", "startup_timeout_sec", "rpc_timeout_sec", "before_send_timeout_sec", "command_timeout_sec", "shutdown_timeout_sec", "disable_timeout_sec", "max_restarts", "restart_cooldown_sec"]
              }
            }
          ],
          "properties": {
            "enabled":     { "type": "boolean" },
            "plugins_dir": { "type": "string", "minLength": 1 },
            "default_tool_timeout_ms":  { "type": "integer", "minimum": 0, "description": "Validated even when plugins are disabled. 0 logs a warning: JSON-RPC tools without their own timeout then fail." },
            "startup_timeout_sec":      { "type": "integer", "minimum": 1 },
            "rpc_timeout_sec":          { "type": "integer", "minimum": 1 },
            "before_send_timeout_sec":  { "type": "integer", "minimum": 1 },
            "command_timeout_sec":      { "type": "integer", "minimum": 1 },
            "shutdown_timeout_sec":     { "type": "integer", "minimum": 1 },
            "disable_timeout_sec":      { "type": "integer", "minimum": 1 },
            "max_restarts":             { "type": "integer", "minimum": 1, "description": "Values above 10 log a warning." },
            "restart_cooldown_sec":     { "type": "integer", "minimum": 1, "description": "Values above 3600 log a warning." }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "required": ["servers"], "properties": { "servers": { "minItems": 1 } } }
            }
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "servers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type"],
                "additionalProperties": false,
                "allOf": [
                  { "if": { "properties": { "type": { "const": "stdio" } }, "required": ["type"] }, "then": { "required": ["command"] } },
                  { "if": { "properties": { "type": { "enum": ["sse", "http"] } }, "required": ["type"] }, "then": { "required": ["url"] } }
                ],
                "properties": {
                  "name":    { "type": "string", "minLength": 1 },
                  "type":    { "type": "string", "enum": ["stdio", "sse", "http"] },
                  "command": { "type": "string", "description": "stdio: executable name or path." },
                  "args":    { "type": "array", "items": { "type": "string" } },
                  "env":     { "type": "object", "additionalProperties": { "type": "string" }, "description": "stdio: environment for the subprocess; names keep their case." },
                  "url":     { "type": "string", "description": "sse/http: endpoint URL." },
                  "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "http only: sent with every request; $VAR is expanded from the bot's environment." }
                }
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shutdown_timeout_sec", "cleanup_interval_min"],
          "properties": {
            "shutdown_timeout_sec": { "type": "integer", "minimum": 1 },
            "cleanup_interval_min": { "type": "integer", "minimum": 1 },
            "hot_reload": {
              "type": "object",
              "additionalProperties": false,
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": { "required": ["debounce_ms"], "properties": { "debounce_ms": { "minimum": 50 } } }
                }
              ],
              "properties": {
                "enabled":     { "type": "boolean" },
                "debounce_ms": { "type": "integer", "minimum": 0, "maximum": 60000, "description": "50-60000 when enabled." }
              }
            }
          }
        }
      }
    }
  }
}
